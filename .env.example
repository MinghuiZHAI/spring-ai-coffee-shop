# ===== 与 backend/src/main/resources/application.yml 的占位符一一对应 =====
# 本文件是模板：新环境执行 `cp .env.example .env` 后填入真实值；.env 已被 .gitignore 排除

# MySQL root 密码（本地开发默认与 yml 兜底值一致；生产务必改为强密码）
MYSQL_ROOT_PASSWORD=change-me

# DashScope API Key（获取入口：百炼控制台 → API-KEY 管理）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# JWT 签名密钥（至少 32 字节随机串，生产必须更换）
JWT_SECRET=change-me-to-a-random-32-bytes-min-string
